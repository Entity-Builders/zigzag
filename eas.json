{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "corepack": true,
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      },
      "ios": {
        "image": "sdk-55"
      },
      "android": {
        "image": "sdk-55"
      },
      "cache": {
        "key": "zigzag-{{ checksum 'yarn.lock' }}",
        "paths": ["node_modules"]
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_SUPABASE_URL": "http://localhost:54321",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "dummy_anon_key",
        "EXPO_PUBLIC_SUPABASE_SCHEMA": "zigzag"
      }
    },
    "development-simulator": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_SUPABASE_URL": "http://127.0.0.1:54321",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "dummy_anon_key",
        "EXPO_PUBLIC_SUPABASE_SCHEMA": "zigzag"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_SUPABASE_SCHEMA": "zigzag",
        "EXPO_PUBLIC_ZIGZAG_POSTHOG_API_KEY": "phc_qbOs8NcMhS1B2mMobn0BdGjZnsLziZyALUyFmcGAjUa"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_SUPABASE_SCHEMA": "zigzag",
        "EXPO_PUBLIC_ZIGZAG_POSTHOG_API_KEY": "phc_qbOs8NcMhS1B2mMobn0BdGjZnsLziZyALUyFmcGAjUa"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6760234733"
      }
    }
  }
}
