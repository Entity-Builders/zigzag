{
  "name": "zigzag",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --lan",
    "start:web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "build:eas": "npx eas-cli build",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview --platform ios",
    "build:prod": "eas build --profile production --platform ios",
    "build:preview:testflight": "eas build --profile preview-testflight --platform ios --auto-submit",
    "eas:config": "node scripts/generate-eas-config.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.1",
    "@supabase/supabase-js": "^2.98.0",
    "expo": "~55.0.5",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.11",
    "expo-linking": "~55.0.7",
    "expo-location": "~55.1.2",
    "expo-router": "~55.0.4",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.12",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
