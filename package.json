{
  "name": "zigzag",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web",
    "start:web": "expo start --web",
    "start:native": "expo start --dev-client --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "build:eas": "npx eas-cli build",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview --platform ios",
    "build:prod": "eas build --profile production --platform ios",
    "build:preview:testflight": "eas build --profile preview-testflight --platform ios --auto-submit",
    "eas:config": "node scripts/generate-eas-config.js",
    "supabase:edge-functions": "cd ../eb-infra &&  npx supabase functions serve --no-verify-jwt --env-file .env.local",
    "run:engine": "./scripts/run-engine.sh"
  },
  "dependencies": {
    "@entity-builders/analytics": "1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "^5.1.2",
    "@supabase/supabase-js": "^2.98.0",
    "expo": "~55.0.26",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-linking": "~55.0.15",
    "expo-location": "~55.1.10",
    "expo-router": "~55.0.16",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.24",
    "posthog-react-native": "^4.37.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19",
    "@types/react-native-web": "^0",
    "typescript": "~5.9.2"
  },
  "private": true
}
